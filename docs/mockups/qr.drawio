<mxfile><diagram name="Mockup QR"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b&gt;1. Mis entradas&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;Cliente · desde el perfil&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="280" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="280" height="520" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cine Paradiso&lt;/b&gt;" style="rounded=0;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="260" height="36" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Mis entradas&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="106" width="240" height="26" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Casablanca&lt;/b&gt;&lt;br&gt;Local Centro · Sala 2&lt;br&gt;Sáb 31/10 · 20:30&lt;br&gt;Butacas F7, F8&lt;br&gt;&lt;font color="#2e7d32"&gt;&lt;b&gt;Pagada&lt;/b&gt;&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="138" width="240" height="200" as="geometry"/></mxCell><mxCell id="c8" value="QR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="210" width="80" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Cancelar compra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="296" width="220" height="32" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;El Padrino&lt;/b&gt;&lt;br&gt;Local Norte · Sala 1&lt;br&gt;Vie 16/10 · 18:00&lt;br&gt;Butaca C4&lt;br&gt;&lt;font color="#888888"&gt;&lt;b&gt;Usada&lt;/b&gt;&lt;/font&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="240" height="150" as="geometry"/></mxCell><mxCell id="c11" value="No se puede cancelar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;fontColor=#888888;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="458" width="220" height="32" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;2. Cancelar compra&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;Cliente · link del mail&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="0" width="280" height="40" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="280" height="520" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Cine Paradiso&lt;/b&gt;" style="rounded=0;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="260" height="36" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;¿Cancelar tu compra?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="350" y="106" width="240" height="26" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Casablanca&lt;/b&gt;&lt;br&gt;Local Centro · Sala 2&lt;br&gt;Sáb 31/10 · 20:30&lt;br&gt;Butacas F7, F8&lt;br&gt;Total: $ 9.000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="350" y="138" width="240" height="110" as="geometry"/></mxCell><mxCell id="c17" value="Se liberan las butacas y el QR deja de servir. Podés cancelar hasta 2 horas antes de la función." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="350" y="258" width="240" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Sí, cancelar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontStyle=1;fillColor=#c62828;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="220" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Volver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;fontColor=#888888;strokeColor=none;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="376" width="220" height="36" as="geometry"/></mxCell><mxCell id="c20" value='&lt;i&gt;Fuera de plazo: el botón se deshabilita y dice&lt;br&gt;"Ya no se puede cancelar: faltan menos de 2 horas".&lt;/i&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="430" width="240" height="50" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;3. Validar ingreso: válido&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;Admin · backoffice en el celular&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="0" width="280" height="40" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="50" width="280" height="520" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Cine Paradiso&lt;/b&gt;" style="rounded=0;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="260" height="36" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Validar ingreso&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="680" y="106" width="240" height="26" as="geometry"/></mxCell><mxCell id="c25" value="Función: Casablanca · Sala 2 · 20:30 ▾" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="138" width="240" height="32" as="geometry"/></mxCell><mxCell id="c26" value='&lt;font style="font-size:40px"&gt;✔&lt;/font&gt;&lt;br&gt;&lt;b&gt;Ingreso válido&lt;/b&gt;&lt;br&gt;2 entradas · Butacas F7, F8&lt;br&gt;Renzo P.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="680" y="184" width="240" height="180" as="geometry"/></mxCell><mxCell id="c27" value="Escanear otro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="380" width="220" height="36" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;4. Validar ingreso: rechazado&lt;/b&gt;&lt;br&gt;&lt;font color="#666666"&gt;Admin · backoffice en el celular&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="280" height="40" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="990" y="50" width="280" height="520" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Cine Paradiso&lt;/b&gt;" style="rounded=0;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="260" height="36" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Validar ingreso&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1010" y="106" width="240" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Función: Casablanca · Sala 2 · 20:30 ▾" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="138" width="240" height="32" as="geometry"/></mxCell><mxCell id="c33" value='&lt;font style="font-size:40px"&gt;✖&lt;/font&gt;&lt;br&gt;&lt;b&gt;QR rechazado&lt;/b&gt;&lt;br&gt;Ya fue utilizado el 31/10 a las 20:12' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontColor=#b71c1c;" vertex="1" parent="1"><mxGeometry x="1010" y="184" width="240" height="180" as="geometry"/></mxCell><mxCell id="c34" value="Otros motivos: cancelado · es de otra función · es de otro día" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#888888;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="372" width="240" height="36" as="geometry"/></mxCell><mxCell id="c35" value="Escanear otro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="220" height="36" as="geometry"/></mxCell><mxCell id="c36" value="El QR lleva una URL del backoffice con un token firmado. El admin lo escanea con la cámara del celular, que abre la pantalla 3 o 4." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
