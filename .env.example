# Copiar como .env (init.sh lo hace solo) y ajustar. El .env no se commitea.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cine_paradiso

API_PORT=5000
API_SECRET_KEY=cambiar-por-un-texto-largo-y-aleatorio

WEB_PORT=5001
API_URL=http://localhost:5000/cine_paradiso_api
WEB_SECRET_KEY=cambiar-por-un-texto-largo-y-aleatorio


# Mailpit (docker compose) atrapa los mails y los muestra en http://localhost:8025.
# Acepta cualquier usuario y contraseña: no hace falta cambiarlos.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=cine
MAIL_PASSWORD=cine
MAIL_FROM=no-reply@cineparadiso.com